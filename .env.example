# Routiqo Root Environment Configuration Example

# PostgreSQL Configuration
POSTGRES_DB=routiqo
POSTGRES_USER=routiqo_user
POSTGRES_PASSWORD=routiqo_password
POSTGRES_PORT=5432

# Backend Database Connection (used by Django container)
DB_HOST=db
DB_PORT=5432
DB_NAME=routiqo
DB_USER=routiqo_user
DB_PASSWORD=routiqo_password

# Django Settings
DJANGO_SECRET_KEY=django-insecure-routiqo-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URLs (browser facing)
VITE_API_URL=http://localhost:8000/api
VITE_LANDING_URL=http://localhost:5173
VITE_DASHBOARD_URL=http://localhost:5174
VITE_APP_NAME=Routiqo

# OSRM Endpoint
OSRM_ENDPOINT=https://router.project-osrm.org

