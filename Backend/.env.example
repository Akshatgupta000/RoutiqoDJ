# Django Application Configuration
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-routiqo-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=routiqo
DB_USER=routiqo_user
DB_PASSWORD=routiqo_password

# Optional PostgreSQL Container Env (for docker-compose)
POSTGRES_DB=routiqo
POSTGRES_USER=routiqo_user
POSTGRES_PASSWORD=routiqo_password

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_ALL_ORIGINS=False

# OSRM Service Endpoint
OSRM_ENDPOINT=https://router.project-osrm.org

# Geocoding Service & Application URL
APP_NAME=Routiqo
APP_URL=http://localhost:8000

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@example.com

# Optional Data Migration from MongoDB Atlas (one-time import utility only)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/logiroute
# MONGODB_DATABASE=logiroute
